# Local private configuration
/.Claude.json
/.claude/settings.local.json

# Local WorkBuddy memory; keep skill bridges trackable.
/.workbuddy/memory/

# Local memory contents; retain directory skeleton placeholders.
/.memory/**
!/.memory/**/
!/.memory/**/.gitkeep

# Local project outputs; retain only governance skeleton and EXE builder sources.
/output/*
!/output/00_系统治理/
/output/00_系统治理/*
!/output/00_系统治理/目录.md
!/output/00_系统治理/版本记录.md
!/output/00_系统治理/01_问题答疑/
/output/00_系统治理/01_问题答疑/*
!/output/00_系统治理/01_问题答疑/.gitkeep
!/output/00_系统治理/02_课题研究/
/output/00_系统治理/02_课题研究/*
!/output/00_系统治理/02_课题研究/.gitkeep
!/output/00_系统治理/03_代码程序/
/output/00_系统治理/03_代码程序/*
!/output/00_系统治理/03_代码程序/.gitkeep
!/output/00_系统治理/03_代码程序/src/
/output/00_系统治理/03_代码程序/src/.b09_*.json
# Keep the initializer's tracked placeholder despite global local-settings ignores.
!/output/00_系统治理/03_代码程序/src/templates/.claude/settings.local.json

# Runtime input and temp contents
/input/*
!/input/.gitkeep
/.temp/*
!/.temp/.gitkeep

# Local history snapshots; Git keeps repository history.
/.history/**
!.history/
!.history/output/
!.history/output/.gitkeep
!.history/AGENTS/
!.history/AGENTS/.gitkeep
!.history/CLAUDE/
!.history/CLAUDE/.gitkeep
!.history/.agents/
!.history/.agents/rules/
!.history/.agents/rules/.gitkeep
!.history/.agents/skills/
!.history/.agents/skills/.gitkeep
!.history/.claude/
!.history/.claude/.gitkeep
!.history/.claude/commands/
!.history/.claude/commands/.gitkeep
!.history/.memory/
!.history/.memory/对话记录/
!.history/.memory/对话记录/.gitkeep
!.history/.memory/知识提炼/
!.history/.memory/知识提炼/.gitkeep
!.history/.memory/系统记录/
!.history/.memory/系统记录/.gitkeep
!.history/.memory/全局知识地图/
!.history/.memory/全局知识地图/.gitkeep
!.history/.system/
!.history/.system/.gitkeep
!.history/.system/standards/
!.history/.system/standards/.gitkeep

# Build and cache artifacts
__pycache__/
*.py[cod]
*.pyo
*.log
**/build_tmp/
*.spec
*.exe

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
